# ---------------------------------------------------------------------------
# Birthday Gifting API — environment
# Copy to apps/api/.env for local development. Every variable is documented in
# docs/ENVIRONMENT.md. The API refuses to start if a required value is missing.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public URLs (used in share links, webhook callbacks and invites)
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:4000
APP_DEEP_LINK_SCHEME=bday

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://bday:bday_dev_password@localhost:5432/bday?schema=public
# Optional locally; required when running more than one API instance.
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters-aaaa
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-bbbb
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=60
BCRYPT_ROUNDS=12
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: returns OTP codes in API responses. Refused in production.
OTP_DEBUG_ECHO=true

# Comma-separated OAuth client ids (web, iOS and Android ids for Google)
GOOGLE_CLIENT_IDS=
# Apple: your app's bundle id and/or Services id
APPLE_CLIENT_IDS=

# --- Security ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3 or any S3-compatible service (MinIO from docker-compose shown here)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI gift assistant ------------------------------------------------------
# Without a key the assistant endpoint reports AI_UNAVAILABLE; gift matching
# (/ai/gift-matches) still works because it does not call a model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=16000

# --- Payments ---------------------------------------------------------------
PAYMENTS_DEFAULT_CURRENCY=KES
# true = sandbox adapter settles payments on verify (never allowed in production)
PAYMENTS_SANDBOX=true

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random secret appended to the M-Pesa callback URL to authenticate callbacks
MPESA_CALLBACK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Platform commission on marketplace sales, in basis points (1000 = 10%)
PLATFORM_COMMISSION_BPS=1000

# --- Notifications ----------------------------------------------------------
EXPO_ACCESS_TOKEN=
SMS_DRIVER=console
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

EMAIL_DRIVER=console
EMAIL_FROM=Birthday App <hello@localhost>
SMTP_URL=
RESEND_API_KEY=

# --- Workers ----------------------------------------------------------------
RUN_WORKERS_IN_PROCESS=true
REMINDER_CRON=*/15 * * * *
SCHEDULED_DELIVERY_CRON=*/5 * * * *
PAYMENT_RECONCILE_CRON=*/10 * * * *

# --- Seed (npm run db:seed) -------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
