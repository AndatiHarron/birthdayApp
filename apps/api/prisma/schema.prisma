  USER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

enum OtpPurpose {
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum RelationshipType {
  FAMILY
  CLOSE_FRIEND
  FRIEND
  COLLEAGUE
  PARTNER
  OTHER
}

enum FriendshipStatus {
  PENDING
