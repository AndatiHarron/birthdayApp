// Birthday gifting platform — PostgreSQL schema (spec §41).
//
// Conventions used throughout:
//   * Ids are cuid()s. They are unguessable, so they are safe in share links.
//   * Money is an Int count of minor units plus a `currency` column. Never a
//     Float — group-gift progress has to add up exactly.
//   * A birthday is stored as (birthMonth, birthDay, birthYear?) rather than a
//     timestamp: it is a calendar anniversary, not an instant, so it must not
//     shift with the reader's time zone.
//   * `deletedAt` marks a soft delete. Rows that carry money or history are
//     soft-deleted so ledgers stay intact.
//   * Every enum here mirrors `packages/shared/src/enums.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ==================================================================== *
 * Enums
 * ====================================================================
 */

