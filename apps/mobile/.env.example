# API base URL. On a physical phone use your computer's LAN IP, e.g.
# http://192.168.1.20:4000 — "localhost" on the phone is the phone itself.
# Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Public web origin used when building share links for display.
EXPO_PUBLIC_WEB_URL=http://localhost:4000
